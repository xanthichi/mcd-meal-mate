{
  "name": "mcd-meal-mate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "M餐搭子 - 基于麦当劳 MCP 实时菜单与营养数据的智能搭餐 Skill",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,red \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:pages": "vite build --mode pages",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vitest run"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
